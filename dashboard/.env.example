API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com/prod
DASHBOARD_TOKEN=replace-with-dashboard-bearer-token
MOCK_API=0

# Non-secret exact origins for local end-to-end login (comma-separated).
# DASHBOARD_EXTRA_ORIGINS=http://127.0.0.1:43123
# Only localhost/127.0.0.1 request URLs may disable Secure, even in production.
# DASHBOARD_COOKIE_SECURE=false
