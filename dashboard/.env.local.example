# Dev Supabase — the analytics plane reads through server-side RPCs only.
# The browser never sees this key: it is used exclusively inside
# app/api/analytics/route.ts, which is the sole caller of the database.
SUPABASE_URL=https://jqgmcnlfxzzhrvrzpoye.supabase.co

# Project Settings -> API Keys -> service_role (or "secret").
# When the restricted analytics key exists, set SUPABASE_ANALYTICS_KEY instead
# and this one can be dropped; the code prefers the restricted key.
SUPABASE_SERVICE_ROLE_KEY=

# How long an aggregate is reused before the database is asked again.
ANALYTICS_CACHE_TTL_MS=300000

# --- restricted-token mode (what ships to AWS) ---
# apikey and Authorization are DIFFERENT credentials. A restricted JWT is not a
# project key, so it cannot go in the apikey slot; pair it with the publishable
# key or PostgREST answers "Invalid API key".
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_ANALYTICS_JWT=<JWT minted for the analytics_reader role>
